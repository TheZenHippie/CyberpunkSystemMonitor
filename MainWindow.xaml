<Window x:Class="CyberpunkSystemMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CyberpunkSystemMonitor.Controls"
        Title="Cyberpunk System Monitor"
        Icon="icon.png"
        Height="820" Width="760"
        MinHeight="450" MinWidth="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        SizeChanged="Window_SizeChanged"
        ContextMenuOpening="Window_ContextMenuOpening">

    <Window.Resources>
        <!-- Dark ScrollBar Styles -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="true">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineUpCommand}" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#4000F0FF" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.LineDownCommand}" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Panel Style -->
        <Style x:Key="CyberPanel" TargetType="Border">
            <Setter Property="Background" Value="#0F141F"/>
            <Setter Property="BorderBrush" Value="#2500F0FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="CyberPanelHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#00F0FF"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="CyberSubText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="CyberValueText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#00FF66"/>
            <Setter Property="FontFamily" Value="Consolas, Segoe UI, sans-serif"/>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#90FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#00F0FF"/>
                    <Setter Property="Background" Value="#2000F0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Window.ContextMenu>
        <ContextMenu x:Name="MainContextMenu"
                     PreviewMouseMove="MainContextMenu_PreviewMouseMove"
                     PreviewMouseLeftButtonDown="MainContextMenu_PreviewMouseLeftButtonDown"
                     Closed="MainContextMenu_Closed">

            <!-- Refresh Interval -->
            <MenuItem x:Name="RefreshIntervalMenuItem" Header="Telemetry Polling Rate">
                <MenuItem Header="Fast (500 ms)" Click="RefreshInterval_Click" Tag="500"/>
                <MenuItem Header="Normal (1000 ms)" Click="RefreshInterval_Click" Tag="1000" IsChecked="True"/>
                <MenuItem Header="Relaxed (2000 ms)" Click="RefreshInterval_Click" Tag="2000"/>
                <MenuItem Header="Eco (5000 ms)" Click="RefreshInterval_Click" Tag="5000"/>
            </MenuItem>

            <!-- Process Count Limit -->
            <MenuItem x:Name="ProcessLimitMenuItem" Header="Top Processes Count">
                <MenuItem Header="Top 5" Click="ProcessLimit_Click" Tag="5"/>
                <MenuItem Header="Top 8" Click="ProcessLimit_Click" Tag="8" IsChecked="True"/>
                <MenuItem Header="Top 12" Click="ProcessLimit_Click" Tag="12"/>
                <MenuItem Header="Top 16" Click="ProcessLimit_Click" Tag="16"/>
                <MenuItem Header="Top 24" Click="ProcessLimit_Click" Tag="24"/>
            </MenuItem>

            <!-- Process Sort Mode -->
            <MenuItem x:Name="ProcessSortMenuItem" Header="Process Sorting">
                <MenuItem Header="Sort by Memory (RAM)" Click="ProcessSort_Click" Tag="Memory" IsChecked="True"/>
                <MenuItem Header="Sort by CPU Usage" Click="ProcessSort_Click" Tag="Cpu"/>
            </MenuItem>
            <Separator/>

            <!-- LED Color Palette -->
            <MenuItem x:Name="LedColorMenuItem" Header="HUD Accent Color">
                <MenuItem Header="Electric Cyan" Click="LedColor_Click" Tag="#00F0FF" IsChecked="True">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00F0FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Matrix Green" Click="LedColor_Click" Tag="#00FF66">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#00FF66" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Solar Amber" Click="LedColor_Click" Tag="#FFB000">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FFB000" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Synthwave Magenta" Click="LedColor_Click" Tag="#FF007F">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF007F" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Night City Violet" Click="LedColor_Click" Tag="#A040FF">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#A040FF" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Glitch Red" Click="LedColor_Click" Tag="#FF2244">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#FF2244" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Phosphor White" Click="LedColor_Click" Tag="#F0F0F0">
                    <MenuItem.Icon>
                        <Border Width="16" Height="16" CornerRadius="3" Background="#F0F0F0" BorderBrush="#80FFFFFF" BorderThickness="1"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Custom Color..." Click="CustomColor_Click"/>
            </MenuItem>

            <!-- RGB Spectrum Cycling & Speed -->
            <MenuItem x:Name="RgbCycleMenuItem" Header="RGB Spectrum Cycling" IsCheckable="True" IsChecked="False" Click="RgbCycle_Click">
                <MenuItem.Icon>
                    <Border Width="16" Height="16" CornerRadius="3" BorderBrush="#80FFFFFF" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF0055" Offset="0.0"/>
                                <GradientStop Color="#FFE600" Offset="0.33"/>
                                <GradientStop Color="#00FF66" Offset="0.66"/>
                                <GradientStop Color="#00F0FF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="210" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="RGB Cycle Speed" FontWeight="SemiBold"/>
                            <TextBlock x:Name="RgbCycleSpeedValueText" Text="1.0x" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="RgbCycleSpeedSlider"
                                Minimum="0.2" Maximum="3.0" Value="1.0"
                                SmallChange="0.1" LargeChange="0.5"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="RgbCycleSpeedSlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>
            <Separator/>

            <!-- Window Opacity Slider -->
            <MenuItem StaysOpenOnClick="True">
                <MenuItem.Header>
                    <StackPanel Width="210" Margin="0,2">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="Window Glass Opacity" FontWeight="SemiBold"/>
                            <TextBlock x:Name="OpacityValueText" Text="90%" DockPanel.Dock="Right" Foreground="#666666"/>
                        </DockPanel>
                        <Slider x:Name="OpacitySlider"
                                Minimum="0.30" Maximum="1.0" Value="0.90"
                                SmallChange="0.05" LargeChange="0.10"
                                Margin="0,6,0,2"
                                PreviewMouseWheel="Slider_PreviewMouseWheel"
                                ValueChanged="OpacitySlider_ValueChanged"/>
                    </StackPanel>
                </MenuItem.Header>
            </MenuItem>

            <!-- Background Theme Tint -->
            <MenuItem Header="Window Tint">
                <MenuItem Header="Deep Cyan Tint" Click="WindowTint_Click" Tag="#100A101A"/>
                <MenuItem Header="Dark Onyx (Neutral)" Click="WindowTint_Click" Tag="#100B0D12"/>
                <MenuItem Header="Midnight Purple" Click="WindowTint_Click" Tag="#1210081C"/>
                <MenuItem Header="Matrix Charcoal" Click="WindowTint_Click" Tag="#1007130B"/>
            </MenuItem>
            <Separator/>

            <!-- Visual FX Suite -->
            <MenuItem Header="Visual FX Suite">
                <MenuItem x:Name="LedGlowMenuItem" Header="LED Matrix Bloom Glow" IsCheckable="True" IsChecked="True" Click="LedGlow_Click"/>
                <Separator/>
                <MenuItem x:Name="RainbowBorderMenuItem" Header="Cyberpunk Rainbow Border" IsCheckable="True" IsChecked="False" Click="RainbowBorder_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="210" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Rainbow Border Width" FontWeight="SemiBold"/>
                                <TextBlock x:Name="RainbowBorderThicknessValueText" Text="3px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="RainbowBorderThicknessSlider"
                                    Minimum="1" Maximum="10" Value="3"
                                    SmallChange="1" LargeChange="2"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="RainbowBorderThicknessSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="CrtScanlinesMenuItem" Header="Retro CRT Scanlines" IsCheckable="True" IsChecked="False" Click="CrtScanlines_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="210" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Scanline Density" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ScanlineThicknessValueText" Text="3px" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="ScanlineThicknessSlider"
                                    Minimum="2" Maximum="10" Value="3"
                                    SmallChange="1" LargeChange="2"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="ScanlineThicknessSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="CrtGlitchMenuItem" Header="CRT Glitch &amp; Jitter FX" IsCheckable="True" IsChecked="False" Click="CrtGlitch_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="210" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Glitch Intensity" FontWeight="SemiBold"/>
                                <TextBlock x:Name="GlitchChanceValueText" Text="15%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="GlitchChanceSlider"
                                    Minimum="1" Maximum="100" Value="15"
                                    SmallChange="5" LargeChange="10"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="GlitchChanceSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
                <Separator/>
                <MenuItem x:Name="CrtSnowMenuItem" Header="CRT Static Snow Noise" IsCheckable="True" IsChecked="False" Click="CrtSnow_Click"/>
                <MenuItem StaysOpenOnClick="True">
                    <MenuItem.Header>
                        <StackPanel Width="210" Margin="0,2">
                            <DockPanel LastChildFill="False">
                                <TextBlock Text="Snow Static Level" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SnowAmountValueText" Text="25%" DockPanel.Dock="Right" Foreground="#666666"/>
                            </DockPanel>
                            <Slider x:Name="SnowAmountSlider"
                                    Minimum="5" Maximum="100" Value="25"
                                    SmallChange="5" LargeChange="15"
                                    Margin="0,6,0,2"
                                    PreviewMouseWheel="Slider_PreviewMouseWheel"
                                    ValueChanged="SnowAmountSlider_ValueChanged"/>
                        </StackPanel>
                    </MenuItem.Header>
                </MenuItem>
            </MenuItem>
            <Separator/>

            <!-- Window Options -->
            <MenuItem x:Name="AlwaysOnTopMenuItem" Header="Always on Top" IsCheckable="True" IsChecked="True" Click="AlwaysOnTop_Click"/>
            <MenuItem Header="HUD Font Settings..." Click="FontSettings_Click"/>
            <MenuItem Header="Reset Window Position" Click="ResetPosition_Click"/>
            <Separator/>
            <MenuItem Header="Exit Monitor" Click="Exit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

    <!-- Root Grid -->
    <Grid Margin="10">
        <!-- LAYER 0: Cyber Glass Background & Border -->
        <Border x:Name="MainBackgroundBorder"
                Background="#E80A0D15"
                BorderBrush="#3500F0FF"
                BorderThickness="1.5"
                CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect x:Name="MainDropShadow" BlurRadius="22" ShadowDepth="4" Direction="315" Color="#00F0FF" Opacity="0.3"/>
            </Border.Effect>
        </Border>

        <!-- LAYER 1: Cyber Decorative Corner Grid Accents -->
        <Grid Margin="1" IsHitTestVisible="False">
            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14"
                    BorderBrush="#00F0FF" BorderThickness="2,2,0,0" Margin="2,2,0,0"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14"
                    BorderBrush="#00F0FF" BorderThickness="0,2,2,0" Margin="0,2,2,0"/>
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14"
                    BorderBrush="#00F0FF" BorderThickness="2,0,0,2" Margin="2,0,0,2"/>
            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14"
                    BorderBrush="#00F0FF" BorderThickness="0,0,2,2" Margin="0,0,2,2"/>
        </Grid>

        <!-- LAYER 2: Main Telemetry Content Layout -->
        <Grid Margin="10" x:Name="MainContentGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header / Bar -->
                <RowDefinition Height="*"/>    <!-- Scrollable Telemetry Panels -->
                <RowDefinition Height="Auto"/> <!-- Status Bar Footer -->
            </Grid.RowDefinitions>

            <!-- ROW 0: Header & Action Controls -->
            <DockPanel Grid.Row="0" Margin="2,0,2,8" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <!-- Action Controls (Right) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ManualRefreshBtn" Style="{StaticResource HeaderBtn}" Content="⟳ REFRESH" ToolTip="Instant Telemetry Refresh" Click="ManualRefresh_Click" Margin="0,0,4,0"/>
                    <Button x:Name="PinBtn" Style="{StaticResource HeaderBtn}" Content="📌 TOP" ToolTip="Toggle Always On Top" Click="AlwaysOnTop_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="🗕" ToolTip="Minimize" Click="Minimize_Click" Margin="0,0,4,0"/>
                    <Button Style="{StaticResource HeaderBtn}" Content="✕" ToolTip="Close" Click="Close_Click"/>
                </StackPanel>

                <!-- Title & Badge (Left) -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2000F0FF" BorderBrush="#8000F0FF" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock Text="[SYS.MON // HUD]" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" FontFamily="Consolas"/>
                    </Border>
                    <TextBlock Text="CYBERPUNK TELEMETRY" FontWeight="Bold" FontSize="12" Foreground="White" VerticalAlignment="Center" FontFamily="Consolas"/>
                    <TextBlock x:Name="HeaderCpuBadge" Text=" • CPU: --" FontSize="11" Foreground="#80FFFFFF" VerticalAlignment="Center" Margin="6,0,0,0" FontFamily="Consolas"/>
                </StackPanel>
            </DockPanel>

            <!-- ROW 1: Scrollable Telemetry Modules -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                <StackPanel>
                    <!-- MODULE 1: CPU PROCESSOR -->
                    <Border Style="{StaticResource CyberPanel}">
                        <StackPanel>
                            <!-- Panel Header -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="[01] CPU PROCESSOR" Style="{StaticResource CyberPanelHeader}"/>
                                <TextBlock x:Name="CpuModelText" Text="Detecting CPU..." DockPanel.Dock="Right" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Total CPU Readout & Primary Meter -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Total CPU LED Matrix Display -->
                                <Border Grid.Column="0" Background="#0A0D15" BorderBrush="#3000F0FF" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,8,0">
                                    <controls:LedMatrixStatElement x:Name="CpuLedStat" Text="CPU: 00.0%" DotSize="2.6" DotSpacing="1.0" LedBrush="#00F0FF" GlowBlurRadius="6"/>
                                </Border>

                                <!-- Summary stats + Bar -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="TOTAL CPU LOAD" Style="{StaticResource CyberSubText}"/>
                                        <TextBlock x:Name="CpuLoadSummaryText" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource CyberValueText}"/>
                                    </DockPanel>
                                    <controls:CyberBarMeter x:Name="CpuTotalBar" Height="14" Value="0" Maximum="100" SegmentCount="32" SegmentSpacing="1.5" ActiveColor="#00F0FF" WarningColor="#FFB000" CriticalColor="#FF0055"/>
                                </StackPanel>
                            </Grid>

                            <!-- CPU Details (Cores, Handles, Threads) -->
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CpuCoresText" Grid.Column="0" Text="Cores: -- / Threads: --" Style="{StaticResource CyberSubText}"/>
                                <TextBlock x:Name="CpuProcessesText" Grid.Column="1" Text="Processes: --" Style="{StaticResource CyberSubText}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CpuThreadsText" Grid.Column="2" Text="Threads: --" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </Grid>

                            <!-- Logical Cores Grid -->
                            <TextBlock Text="LOGICAL CORES UTILIZATION MATRIX:" FontSize="9.5" Foreground="#60FFFFFF" Margin="0,2,0,4" FontFamily="Consolas"/>
                            <ItemsControl x:Name="CpuCoresItemsControl">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" Rows="0"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0D111A" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="3" Padding="4,2" Margin="2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="38"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" FontSize="9.5" Foreground="#8000F0FF" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                <controls:CyberBarMeter Grid.Column="1" Height="8" Value="{Binding UsagePercent}" Maximum="100" SegmentCount="12" SegmentSpacing="1.0" ActiveColor="#00F0FF" WarningColor="#FFB000" CriticalColor="#FF0055"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- MODULE 2: SYSTEM MEMORY (RAM) -->
                    <Border Style="{StaticResource CyberPanel}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="[02] SYSTEM MEMORY (RAM)" Style="{StaticResource CyberPanelHeader}"/>
                                <TextBlock x:Name="RamDetailsText" Text="Used: 0.0 GB / Total: 0.0 GB" DockPanel.Dock="Right" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- RAM LED Matrix & Bar -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0A0D15" BorderBrush="#3000FF66" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,8,0">
                                    <controls:LedMatrixStatElement x:Name="RamLedStat" Text="RAM: 00.0%" DotSize="2.6" DotSpacing="1.0" LedBrush="#00FF66" GlowBlurRadius="6"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="PHYSICAL RAM IN USE" Style="{StaticResource CyberSubText}"/>
                                        <TextBlock x:Name="RamPercentText" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource CyberValueText}"/>
                                    </DockPanel>
                                    <controls:CyberBarMeter x:Name="RamBar" Height="14" Value="0" Maximum="100" SegmentCount="32" SegmentSpacing="1.5" ActiveColor="#00FF66" WarningColor="#FFB000" CriticalColor="#FF0055"/>
                                </StackPanel>
                            </Grid>

                            <!-- Memory Breakdown & Commit Charge -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RamAvailableText" Grid.Column="0" Text="Available: 0.0 GB Free" Style="{StaticResource CyberSubText}"/>
                                <TextBlock x:Name="RamCommitText" Grid.Column="1" Text="Commit: 0.0 GB / 0.0 GB" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- MODULE 3: GPU & VRAM -->
                    <Border Style="{StaticResource CyberPanel}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="[03] GRAPHICS PROCESSOR (GPU)" Style="{StaticResource CyberPanelHeader}"/>
                                <TextBlock x:Name="GpuNameText" Text="Detecting GPU..." DockPanel.Dock="Right" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- GPU 3D Load Readout & Bar -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Background="#0A0D15" BorderBrush="#30A040FF" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,8,0">
                                    <controls:LedMatrixStatElement x:Name="GpuLedStat" Text="GPU: 00.0%" DotSize="2.6" DotSpacing="1.0" LedBrush="#A040FF" GlowBlurRadius="6"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="3D CORE ENGINE LOAD" Style="{StaticResource CyberSubText}"/>
                                        <TextBlock x:Name="GpuLoadText" Text="0.0%" DockPanel.Dock="Right" Style="{StaticResource CyberValueText}" Foreground="#A040FF"/>
                                    </DockPanel>
                                    <controls:CyberBarMeter x:Name="GpuLoadBar" Height="14" Value="0" Maximum="100" SegmentCount="32" SegmentSpacing="1.5" ActiveColor="#A040FF" WarningColor="#FFB000" CriticalColor="#FF0055"/>
                                </StackPanel>
                            </Grid>

                            <!-- Video Memory (VRAM) Bar -->
                            <StackPanel Margin="0,2,0,0">
                                <DockPanel Margin="0,0,0,3">
                                    <TextBlock Text="VIDEO MEMORY (VRAM)" Style="{StaticResource CyberSubText}"/>
                                    <TextBlock x:Name="VramDetailsText" Text="0.0 GB / 0.0 GB (0%)" DockPanel.Dock="Right" Style="{StaticResource CyberValueText}" Foreground="#00F0FF"/>
                                </DockPanel>
                                <controls:CyberBarMeter x:Name="VramBar" Height="10" Value="0" Maximum="100" SegmentCount="32" SegmentSpacing="1.5" ActiveColor="#00F0FF" WarningColor="#FFB000" CriticalColor="#FF0055"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- MODULE 4: STORAGE VOLUMES & REAL-TIME I/O ACTIVITY -->
                    <Border Style="{StaticResource CyberPanel}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="[04] STORAGE VOLUMES &amp; REAL-TIME I/O" Style="{StaticResource CyberPanelHeader}"/>
                                <TextBlock Text="ACTIVE DISK MONITORS" DockPanel.Dock="Right" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <!-- Drives Items List -->
                            <ItemsControl x:Name="DrivesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#0B0F17" BorderBrush="#1CFFFFFF" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <StackPanel>
                                                <!-- Drive Info & Space -->
                                                <DockPanel Margin="0,0,0,3">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DriveLetter}" FontWeight="Bold" FontSize="11" Foreground="#00F0FF" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding VolumeLabel, StringFormat=' ({0})'}" FontSize="11" Foreground="#90FFFFFF" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding DriveType, StringFormat=' [{0}]'}" FontSize="10" Foreground="#60FFFFFF" Margin="4,0,0,0" FontFamily="Consolas"/>
                                                    </StackPanel>

                                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding SpaceSummary}" FontSize="10.5" Foreground="#00FF66" FontFamily="Consolas"/>
                                                    </StackPanel>
                                                </DockPanel>

                                                <!-- Capacity Bar -->
                                                <controls:CyberBarMeter Height="10" Value="{Binding UsedPercent}" Maximum="100" SegmentCount="28" SegmentSpacing="1.5" ActiveColor="#00F0FF" WarningColor="#FFB000" CriticalColor="#FF0055" Margin="0,0,0,4"/>

                                                <!-- Real-Time Read/Write Activity LEDs & Speed -->
                                                <DockPanel LastChildFill="False">
                                                    <!-- READ Indicator -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:RoundLedIndicator x:Name="ReadLed" LedSize="9" OnBrush="#00FF66" OffBrush="#1000FF66" IsOn="{Binding IsReading}" Margin="0,0,4,0"/>
                                                        <TextBlock Text="READ: " FontSize="9.5" Foreground="#70FFFFFF" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding ReadSpeedFormatted}" FontSize="9.5" FontWeight="SemiBold" Foreground="#00FF66" FontFamily="Consolas" Margin="0,0,12,0"/>
                                                    </StackPanel>

                                                    <!-- WRITE Indicator -->
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <controls:RoundLedIndicator x:Name="WriteLed" LedSize="9" OnBrush="#FF007F" OffBrush="#10FF007F" IsOn="{Binding IsWriting}" Margin="0,0,4,0"/>
                                                        <TextBlock Text="WRITE: " FontSize="9.5" Foreground="#70FFFFFF" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding WriteSpeedFormatted}" FontSize="9.5" FontWeight="SemiBold" Foreground="#FF007F" FontFamily="Consolas"/>
                                                    </StackPanel>

                                                    <!-- Free Space Tag -->
                                                    <TextBlock Text="{Binding FreeSpaceFormatted, StringFormat='FREE: {0}'}" DockPanel.Dock="Right" FontSize="9.5" Foreground="#60FFFFFF" FontFamily="Consolas"/>
                                                </DockPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- MODULE 5: NETWORK INTERFACE -->
                    <Border Style="{StaticResource CyberPanel}">
                        <StackPanel>
                            <!-- Header -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="[05] NETWORK INTERFACE" Style="{StaticResource CyberPanelHeader}"/>
                                <TextBlock x:Name="NetworkIpText" Text="IP: 127.0.0.1" DockPanel.Dock="Right" Style="{StaticResource CyberSubText}" Foreground="#00FF66" HorizontalAlignment="Right"/>
                            </DockPanel>

                            <TextBlock x:Name="NetworkAdapterText" Text="Adapter: Detecting..." FontSize="10.5" Foreground="#80FFFFFF" Margin="0,0,0,6" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>

                            <!-- Network Speed LED Readout -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Download Speed LED -->
                                <Border Grid.Column="0" Background="#0A0D15" BorderBrush="#3000FF66" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="DOWNLOAD (RX)" FontSize="9" Foreground="#60FFFFFF" FontFamily="Consolas" Margin="0,0,0,2"/>
                                        <controls:LedMatrixStatElement x:Name="NetRxLedStat" Text="↓ 0.0 KB/s" DotSize="2.4" DotSpacing="1.0" LedBrush="#00FF66" GlowBlurRadius="6"/>
                                    </StackPanel>
                                </Border>

                                <!-- Upload Speed LED -->
                                <Border Grid.Column="1" Background="#0A0D15" BorderBrush="#3000F0FF" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="UPLOAD (TX)" FontSize="9" Foreground="#60FFFFFF" FontFamily="Consolas" Margin="0,0,0,2"/>
                                        <controls:LedMatrixStatElement x:Name="NetTxLedStat" Text="↑ 0.0 KB/s" DotSize="2.4" DotSpacing="1.0" LedBrush="#00F0FF" GlowBlurRadius="6"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Packet Counts & Totals -->
                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="NetPacketsRecvText" Grid.Column="0" Text="Packets Recv: 0 (0.0 MB)" Style="{StaticResource CyberSubText}"/>
                                <TextBlock x:Name="NetPacketsSentText" Grid.Column="1" Text="Packets Sent: 0 (0.0 MB)" Style="{StaticResource CyberSubText}" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- MODULE 6: ACTIVE PROCESSES & MEMORY CONSUMPTION -->
                    <Border Style="{StaticResource CyberPanel}" Margin="0,0,0,2">
                        <StackPanel>
                            <!-- Header & Sort Toggles -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="[06] TOP RUNNING PROCESSES" Style="{StaticResource CyberPanelHeader}"/>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="SortMemBtn" Style="{StaticResource HeaderBtn}" Content="MEM ▼" FontSize="10" Click="SortMem_Click" Margin="0,0,4,0"/>
                                    <Button x:Name="SortCpuBtn" Style="{StaticResource HeaderBtn}" Content="CPU" FontSize="10" Click="SortCpu_Click"/>
                                </StackPanel>
                            </DockPanel>

                            <!-- Table Header -->
                            <Grid Background="#121824" Margin="0,0,0,3" Height="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="65"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PID" FontSize="9.5" FontWeight="Bold" Foreground="#8000F0FF" VerticalAlignment="Center" Margin="4,0,0,0" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="1" Text="PROCESS NAME" FontSize="9.5" FontWeight="Bold" Foreground="#8000F0FF" VerticalAlignment="Center" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="2" Text="MEMORY" FontSize="9.5" FontWeight="Bold" Foreground="#8000F0FF" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="3" Text="CPU %" FontSize="9.5" FontWeight="Bold" Foreground="#8000F0FF" VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Consolas"/>
                                <TextBlock Grid.Column="4" Text="THRDS" FontSize="9.5" FontWeight="Bold" Foreground="#8000F0FF" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,4,0" FontFamily="Consolas"/>
                            </Grid>

                            <!-- Process Rows ItemsControl -->
                            <ItemsControl x:Name="ProcessesItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#080C14" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="4,2.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="50"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                    <ColumnDefinition Width="65"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="10" Foreground="#50FFFFFF" FontFamily="Consolas"/>
                                                <TextBlock Grid.Column="1" Text="{Binding ProcessName}" FontSize="10" Foreground="White" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MemoryFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="#00FF66" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="3" Text="{Binding CpuFormatted}" FontSize="10" FontWeight="SemiBold" Foreground="#00F0FF" FontFamily="Consolas" HorizontalAlignment="Right"/>
                                                <TextBlock Grid.Column="4" Text="{Binding ThreadCount}" FontSize="10" Foreground="#60FFFFFF" FontFamily="Consolas" HorizontalAlignment="Right" Margin="0,0,2,0"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ROW 2: Status Bar Footer -->
            <Border Grid.Row="2" Margin="2,6,2,0" Background="#0A0D15" BorderBrush="#2000F0FF" BorderThickness="1" CornerRadius="4" Padding="8,4">
                <DockPanel LastChildFill="False">
                    <!-- Left Uptime & Refresh status -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <controls:RoundLedIndicator x:Name="PulseLed" LedSize="7" OnBrush="#00F0FF" OffBrush="#1000F0FF" IsOn="True" Margin="0,0,6,0"/>
                        <TextBlock x:Name="UptimeText" Text="UPTIME: --" FontSize="10" Foreground="#80FFFFFF" FontFamily="Consolas" Margin="0,0,12,0"/>
                        <TextBlock x:Name="RefreshStatusText" Text="POLLING: 1000ms" FontSize="10" Foreground="#00F0FF" FontFamily="Consolas"/>
                    </StackPanel>

                    <!-- Right Hint -->
                    <TextBlock Text="[R-CLICK FOR HUD CONFIG]" DockPanel.Dock="Right" FontSize="9.5" Foreground="#50FFFFFF" VerticalAlignment="Center" FontFamily="Consolas"/>
                </DockPanel>
            </Border>

            <!-- Jitter Transform for CRT Glitch FX -->
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ContentJitterTransform" X="0" Y="0"/>
            </Grid.RenderTransform>
        </Grid>

        <!-- LAYER 3: Retro CRT Overlays (Scanlines, Snow Static, Glitch Slices) -->
        <Grid x:Name="CrtOverlayGrid" Margin="10" IsHitTestVisible="False">
            <!-- CRT Snow Static Overlay -->
            <Image x:Name="CrtSnowOverlay"
                   Stretch="Fill"
                   Visibility="Collapsed"
                   Opacity="0.0"
                   IsHitTestVisible="False"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- Vintage Scanlines -->
            <Rectangle x:Name="CrtScanlinesOverlay"
                       Visibility="Collapsed"
                       Opacity="0.85"
                       IsHitTestVisible="False">
                <Rectangle.Fill>
                    <DrawingBrush x:Name="CrtDrawingBrush" TileMode="Tile" Viewport="0,0,1,6" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#00000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,6"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#F0000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry Rect="0,0,1,3"/>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- CRT Glitch Bars & Chromatic Tears Canvas -->
            <Canvas x:Name="CrtGlitchCanvas"
                    Visibility="Collapsed"
                    IsHitTestVisible="False"
                    ClipToBounds="True"/>
        </Grid>

        <!-- LAYER 4: Cyberpunk Rainbow Border around the window -->
        <Border x:Name="CyberpunkRainbowBorder"
                Margin="6"
                CornerRadius="8"
                BorderThickness="0"
                Visibility="Collapsed"
                IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush x:Name="RainbowGradientBrush" StartPoint="0,0" EndPoint="1,1">
                    <LinearGradientBrush.RelativeTransform>
                        <RotateTransform x:Name="RainbowRotateTransform" CenterX="0.5" CenterY="0.5" Angle="0"/>
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#FF0055" Offset="0.0"/>
                    <GradientStop Color="#FF7700" Offset="0.16"/>
                    <GradientStop Color="#FFE600" Offset="0.33"/>
                    <GradientStop Color="#00FF66" Offset="0.50"/>
                    <GradientStop Color="#00F0FF" Offset="0.67"/>
                    <GradientStop Color="#7000FF" Offset="0.83"/>
                    <GradientStop Color="#FF007F" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect x:Name="RainbowGlowEffect"
                                  BlurRadius="14"
                                  ShadowDepth="0"
                                  Color="#00F0FF"
                                  Opacity="0.8"
                                  RenderingBias="Performance"/>
            </Border.Effect>
        </Border>

        <!-- LAYER 5: Resize Grip -->
        <ResizeGrip HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,12,12"
                    Opacity="0.4"
                    Cursor="SizeNWSE"/>
    </Grid>
</Window>
